#!/bin/sh
# Sourced by the nginx entrypoint (.envsh) before 20-envsubst-on-templates.sh,
# so the exported value is visible to envsubst when rendering the config.
#
# Picks the DNS resolver for nginx's runtime proxy_pass resolution:
#   - Docker:     127.0.0.11 (embedded DNS) — read from /etc/resolv.conf
#   - Kubernetes / OpenShift: the CoreDNS ClusterIP — also in /etc/resolv.conf
# Honors an explicit CONVERTER_RESOLVER if the operator set one.

if [ -z "${CONVERTER_RESOLVER}" ]; then
    CONVERTER_RESOLVER="$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)"
    [ -z "${CONVERTER_RESOLVER}" ] && CONVERTER_RESOLVER="127.0.0.11"
fi
export CONVERTER_RESOLVER
