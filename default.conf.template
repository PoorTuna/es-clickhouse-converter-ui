# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst entrypoint. Only ${CONVERTER_*} vars are substituted (see
# NGINX_ENVSUBST_FILTER in the Dockerfile); nginx's own $host/$uri/etc. survive.
#
# Listens on 8080 (unprivileged) so the container needs no root and runs as-is
# under OpenShift's restricted SCC.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse-proxy API calls to the converter backend. The address comes from
    # CONVERTER_BACKEND_URL and is resolved lazily via ${CONVERTER_RESOLVER}
    # (auto-detected: Docker embedded DNS, or cluster CoreDNS on k8s/OpenShift),
    # so the container starts even when the backend is not yet reachable.
    location /convert {
        resolver ${CONVERTER_RESOLVER} ipv6=off valid=10s;
        set $converter_backend "${CONVERTER_BACKEND_URL}";
        proxy_pass $converter_backend$request_uri;
        proxy_set_header Host $host;
    }
    location /health {
        resolver ${CONVERTER_RESOLVER} ipv6=off valid=10s;
        set $converter_backend "${CONVERTER_BACKEND_URL}";
        proxy_pass $converter_backend$request_uri;
        proxy_set_header Host $host;
    }
    # Live-Elasticsearch connect/browse/import endpoints.
    location /es {
        resolver ${CONVERTER_RESOLVER} ipv6=off valid=10s;
        set $converter_backend "${CONVERTER_BACKEND_URL}";
        proxy_pass $converter_backend$request_uri;
        proxy_set_header Host $host;
    }
}
